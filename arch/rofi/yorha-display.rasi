@import "yorha.rasi"

window {
    width: 580px;
}

topnav {
    enabled: false;
}

textbox-section-title {
    content: "DISPLAY";
}

textbox-section-sub {
    content: "—  Output Control";
}

listview {
    lines:        12;
    fixed-height: true;
}

element {
    children: [ textbox-ptr, element-text ];
}

element-icon {
    enabled: false;
}

element-text {
    padding: 8px 14px;
}

textbox-hint {
    content: "Select output mode.";
}
