@import "tokens.rasi"

* {
    background-color: transparent;
    text-color:       @text;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

/* Outer wrapper renders hard non-blurred 5px offset shadow on right & bottom */
window {
    location:         center;
    anchor:           center;
    width:            640px;
    background-color: @shadow-hard;
    padding:          0px 5px 5px 0px;
    border:           0px;
    border-radius:    0px;
}

mainbox {
    orientation:      vertical;
    background-color: @bg-surface;
    border:           2px solid;
    border-color:     @primary;
    spacing:          0px;
    children:         [ section-header, topnav, body-pad, footerbar ];
}

/* ── 1. NieR Top Navigation Bar (|| [■ Applications] [■ Windows] [■ Execute] ... 01) ── */
topnav {
    orientation:      horizontal;
    expand:           false;
    background-color: @bg;
    padding:          6px 14px 0px 14px;
    spacing:          8px;
    border:           0px 0px 2px 0px;
    border-color:     @primary;
    children:         [ nav-double-bar, mode-switcher, textbox-dmenu-title, dummy-topnav, textbox-index ];
}

nav-double-bar {
    orientation:      horizontal;
    expand:           false;
    spacing:          2px;
    margin:           2px 4px 6px 0px;
    children:         [ nav-bar-thick, nav-bar-thin ];
}

nav-bar-thick {
    expand:           false;
    width:            7px;
    background-color: @primary;
}

nav-bar-thin {
    expand:           false;
    width:            3px;
    background-color: @primary;
}

mode-switcher {
    orientation:      horizontal;
    expand:           false;
    width:            430px;
    spacing:          4px;
}

/* Inactive category tabs sit slightly above the bottom rule; active tab drops flush to rule */
button {
    padding:          5px 12px;
    margin:           0px 0px 4px 0px;
    background-color: @bg-muted;
    text-color:       @primary;
    border:           0px;
    font:             "Noto Sans Medium 10";
    vertical-align:   0.5;
}

button selected {
    padding:          5px 14px 9px 14px;
    margin:           0px;
    background-color: @primary-dark;
    text-color:       @bg-surface;
    border:           2px 0px 0px 0px;
    border-color:     @primary;
    font:             "Noto Sans SemiBold 10";
}

/* Shown only when launched in -dmenu mode (e.g. SUPER + Esc System Menu) */
textbox-dmenu-title {
    enabled:          false;
    expand:           false;
    margin:           0px 0px 6px 0px;
    padding:          5px 14px;
    background-color: @primary-dark;
    text-color:       @bg-surface;
    font:             "Noto Sans SemiBold 10.5";
    content:          "■  SYSTEM";
    vertical-align:   0.5;
}

dummy-topnav {
    expand:           true;
}

textbox-index {
    expand:           false;
    margin:           0px 0px 6px 0px;
    content:          "【01】";
    text-color:       @primary;
    font:             "JetBrainsMono Nerd Font Mono Medium 9.5";
    vertical-align:   0.5;
}

/* ── 2. Dark/Inverted NieR Section Header Strip ── */
section-header {
    orientation:      horizontal;
    expand:           false;
    background-color: @primary-dark;
    border:           0px 0px 2px 0px;
    border-color:     @primary;
    padding:          8px 16px;
    spacing:          8px;
    children:         [ textbox-section-sq, textbox-section-title, textbox-section-sub, dummy-sec, num-filtered-rows, textbox-slash, num-rows ];
}

textbox-section-sq {
    expand:           false;
    content:          "■";
    text-color:       @bg-surface;
    font:             "JetBrainsMono Nerd Font 12";
    vertical-align:   0.5;
}

textbox-section-title {
    expand:           false;
    content:          "APPLICATIONS";
    text-color:       @bg-surface;
    font:             "Noto Sans SemiBold 13";
    vertical-align:   0.5;
}

textbox-section-sub {
    expand:           false;
    content:          "—  Launcher";
    text-color:       @bg;
    font:             "Noto Sans 10";
    vertical-align:   0.5;
}

dummy-sec {
    expand:           true;
}

/* ── 3. Inner Body Container ── */
body-pad {
    orientation:      vertical;
    expand:           true;
    padding:          10px 18px 10px 18px;
    spacing:          8px;
    background-color: @bg-surface;
    children:         [ inputbar, message, sep-top, list-row, sep-bot ];
}

/* Filter Input Strip (Compact, Non-Expanding) */
inputbar {
    orientation:      horizontal;
    expand:           false;
    background-color: @bg;
    padding:          6px 12px;
    spacing:          8px;
    border:           2px 0px 2px 0px;
    border-color:     @bg-muted;
    children:         [ textbox-cursor, entry ];
}

textbox-cursor {
    expand:           false;
    content:          "◆";
    text-color:       @primary;
    font:             "JetBrainsMono Nerd Font Mono 9.5";
    vertical-align:   0.5;
}

entry {
    expand:           true;
    placeholder:      "Filter...";
    placeholder-color: @primary;
    text-color:       @text;
    font:             "Noto Sans Medium 10.5";
    vertical-align:   0.5;
}

num-filtered-rows,
textbox-slash,
num-rows {
    expand:           false;
    text-color:       @bg;
    font:             "JetBrainsMono Nerd Font Mono 9";
    vertical-align:   0.5;
}

textbox-slash {
    content:          "/";
    padding:          0px 3px;
}

/* Diagnostic / Contextual Message Strip */
message {
    expand:           false;
    background-color: @bg;
    border:           0px 0px 0px 4px;
    border-color:     @primary;
    padding:          5px 10px;
}

textbox {
    text-color:       @primary;
    font:             "JetBrainsMono Nerd Font Mono 9";
}

/* Dot-Line Horizontal Rules (───•) */
sep-top,
sep-bot {
    orientation:      horizontal;
    expand:           false;
    spacing:          6px;
}

sep-top {
    children:         [ sep-top-line, textbox-sep-top-dot ];
}

sep-bot {
    children:         [ sep-bot-line, textbox-sep-bot-dot ];
}

sep-top-line,
sep-bot-line {
    expand:           true;
    margin:           5px 0px;
    border:           0px 0px 2px 0px;
    border-color:     @bg-muted;
}

textbox-sep-top-dot,
textbox-sep-bot-dot {
    expand:           false;
    content:          "•";
    text-color:       @bg-muted;
    font:             "JetBrainsMono Nerd Font Mono 9";
    vertical-align:   0.5;
}

/* ── 4. Asymmetric List Row (Overlaid Double Vertical Bar + List + 3px Scrollbar) ── */
list-row {
    orientation:      horizontal;
    expand:           true;
    spacing:          0px;
    padding:          4px 6px 4px 0px;
    border:           0px 2px 2px 0px;
    border-color:     @bg-muted;
    children:         [ listview ];
}

listview {
    expand:           true;
    lines:            7;
    columns:          1;
    fixed-height:     true;
    dynamic:          false;
    spacing:          0px;
    scrollbar:        true;
    border:           0px;
    background-image: url("vbar.png", none);
}

scrollbar {
    width:            3px;
    handle-width:     3px;
    border:           0px;
    padding:          0px;
    margin:           0px 0px 0px 10px;
    background-color: @bg-muted;
    handle-color:     @primary;
}

/* flick0 staggered step + left overlapping spearhead pointer + button-only selection borders */
element {
    orientation:      horizontal;
    spacing:          0px;
    margin:           0px 18px 0px 0px;
    padding:          3px 0px;
    background-color: transparent;
    background-image: none;
    border:           0px;
    border-radius:    0px;
    children:         [ textbox-ptr, element-icon, element-text ];
}

textbox-ptr {
    expand:           false;
    width:            42px;
    margin:           0px;
    content:          "";
    background-color: transparent;
    background-image: none;
}

textbox-ptr selected.normal,
textbox-ptr selected.active,
textbox-ptr selected.urgent {
    background-color: transparent;
    background-image: url("pointer.png", both);
}

element selected.normal,
element selected.active {
    margin:           0px;
    background-color: transparent;
    background-image: url("sel-border.png", height);
    border:           0px;
}

element selected.urgent {
    margin:           0px;
    background-color: transparent;
    background-image: url("sel-border.png", height);
    border:           0px;
}

/* Square ■ badge framing multicolor app icons:
 * outer border matches row fill so the inner @primary / @bg-surface square floats cleanly inside the row */
element-icon {
    size:             18px;
    padding:          3px;
    background-color: @primary;
    border:           5px solid;
    border-color:     @bg-muted;
    vertical-align:   0.5;
}

element-text {
    expand:           true;
    padding:          7px 12px 7px 6px;
    background-color: @bg-muted;
    text-color:       @primary;
    font:             "Noto Sans Medium 10.5";
    vertical-align:   0.5;
    ellipsize:        "end";
}

element-icon normal.active,
element-icon alternate.active {
    background-color: @primary;
    border-color:     @bg;
}

element-text normal.active,
element-text alternate.active {
    background-color: @bg;
    text-color:       @text;
}

element-icon normal.urgent,
element-icon alternate.urgent {
    background-color: @bg-surface;
    border-color:     @alert;
}

element-text normal.urgent,
element-text alternate.urgent {
    background-color: @alert;
    text-color:       @bg-surface;
}

element-icon selected.normal,
element-icon selected.active {
    background-color: @bg-surface;
    border-color:     @primary-dark;
}

element-text selected.normal,
element-text selected.active {
    background-color: @primary-dark;
    text-color:       @bg-surface;
}

element-icon selected.urgent {
    background-color: @bg-surface;
    border-color:     @alert;
}

element-text selected.urgent {
    background-color: @alert;
    text-color:       @bg-surface;
}

/* ── 5. Bottom Contextual Operator Help Bar (With Inverted Keycaps) ── */
footerbar {
    orientation:      horizontal;
    expand:           false;
    background-color: @bg;
    border:           2px 0px 0px 0px;
    border-color:     @bg-muted;
    padding:          7px 14px;
    spacing:          6px;
    children:         [ fbar-double, textbox-hint, textbox-keycap-nav, textbox-lbl-nav, textbox-keycap-ok, textbox-lbl-ok, textbox-keycap-esc, textbox-lbl-esc, textbox-corner ];
}

fbar-double {
    orientation:      horizontal;
    expand:           false;
    spacing:          2px;
    children:         [ fbar-thick, fbar-thin ];
}

fbar-thick {
    expand:           false;
    width:            6px;
    background-color: @primary;
}

fbar-thin {
    expand:           false;
    width:            2px;
    background-color: @primary;
}

textbox-hint {
    expand:           true;
    margin:           0px 0px 0px 4px;
    content:          "Select entry.";
    text-color:       @primary;
    font:             "Noto Sans 9.5";
    vertical-align:   0.5;
}

textbox-keycap-nav,
textbox-keycap-ok,
textbox-keycap-esc {
    expand:           false;
    background-color: @primary-dark;
    text-color:       @bg-surface;
    padding:          2px 5px;
    font:             "JetBrainsMono Nerd Font Mono SemiBold 8";
    vertical-align:   0.5;
}

textbox-keycap-nav { content: "↑↓"; }
textbox-keycap-ok  { content: "Enter"; }
textbox-keycap-esc { content: "Esc"; }

textbox-lbl-nav,
textbox-lbl-ok,
textbox-lbl-esc {
    expand:           false;
    text-color:       @text;
    margin:           0px 6px 0px 0px;
    font:             "Noto Sans 9";
    vertical-align:   0.5;
}

textbox-lbl-nav { content: "Select"; }
textbox-lbl-ok  { content: "Confirm"; }
textbox-lbl-esc { content: "Back"; }

textbox-corner {
    expand:           false;
    content:          "■";
    text-color:       @primary-dark;
    font:             "JetBrainsMono Nerd Font Mono 7.5";
    vertical-align:   1.0;
}
