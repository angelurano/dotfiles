@import "yorha.rasi"

window {
    width: 480px;
}

topnav {
    enabled: false;
}

textbox-section-title {
    content: "SYSTEM";
}

textbox-section-sub {
    content: "—  Operations";
}

listview {
    lines:        10;
    fixed-height: true;
}

element {
    children: [ textbox-ptr, element-text ];
}

element-icon {
    enabled: false;
}

element-text {
    padding: 8px 14px;
}

textbox-hint {
    content: "Authorized.";
}
